# ─────────────────────────────────────────────
# CIS — Contract Intelligence System
# Copy to .env and fill in real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────

# ── Anthropic ─────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Voyage AI ─────────────────────────────────
VOYAGE_API_KEY=pa-...

# ── Postgres (Neon in prod / docker in dev) ───
DATABASE_URL=postgresql+asyncpg://cis:cis@localhost:5432/cis
# Sync URL for Alembic migrations (uses psycopg2)
DATABASE_SYNC_URL=postgresql+psycopg2://cis:cis@localhost:5432/cis

# ── Neo4j (AuraDB Free in prod / docker in dev) ─
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# ── Google Cloud / BigQuery (GDELT) ───────────
# Path to service account JSON key (never commit the file)
GOOGLE_APPLICATION_CREDENTIALS=apps/api/secrets/gcp.json
GCP_PROJECT_ID=cis-gdelt
BIGQUERY_MAX_BYTES_BILLED=5368709120   # 5 GB per query hard cap

# ── LangSmith ─────────────────────────────────
LANGSMITH_API_KEY=ls__...
LANGSMITH_PROJECT=cis
LANGCHAIN_TRACING_V2=true

# ── Inngest ───────────────────────────────────
INNGEST_SIGNING_KEY=signkey-...
INNGEST_EVENT_KEY=...

# ── Budget caps (USD per day) ─────────────────
# Per-model daily caps enforced by BudgetedClient
BUDGET_CAP_HAIKU_USD=5.0
BUDGET_CAP_OPUS_USD=10.0
# Per-agent daily caps
BUDGET_CAP_PRICES_AGENT_USD=0.50
BUDGET_CAP_GDELT_AGENT_USD=1.00
BUDGET_CAP_SEC_AGENT_USD=1.00
BUDGET_CAP_PRESS_AGENT_USD=1.00
BUDGET_CAP_DEMAND_AGENT_USD=1.00
BUDGET_CAP_LOGISTICS_AGENT_USD=1.00

# ── App settings ──────────────────────────────
ENVIRONMENT=development   # development | production
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# ── SEC EDGAR (no auth, but set User-Agent) ───
SEC_USER_AGENT=cis-research/0.1 a.shablovskiy@gmail.com
